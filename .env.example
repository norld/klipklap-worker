# API key for securing yt-dlp worker endpoints
# Generate a strong random key for production
YTDLP_API_KEY=your-very-secret-api-key-here

# Server port (default: 3002)
PORT=3002

# Node environment
NODE_ENV=production

# Cloudflare Workers/Pages Support
# When using Cloudflare proxy, the app will:
# - Trust the X-Forwarded-For and X-Forwarded-Proto headers
# - Accept API keys from both x-api-key and x-Api-Key (Cloudflare may modify case)
# - Work behind TLS termination

# Browser Cookies Support
# The API now supports --cookies-from-browser flag
# Pass "browser" parameter in API requests: "chrome", "chromium", "firefox", etc.
# Example: { "url": "...", "browser": "chrome" }
# See COOKIES_TUTORIAL.md for details